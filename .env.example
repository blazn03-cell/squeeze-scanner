# APEX Scanner v2 environment variables
# Keep every provider key server-side. Do not create NEXT_PUBLIC_* provider variables.

# Default: mock. Real providers remain disabled until commercial rights are confirmed.
MARKET_DATA_PROVIDER=mock
APEX_SYMBOLS=NVDA,MSFT,SPY
APEX_SCAN_CONCURRENCY=4

# Enable only after written commercial display/redistribution rights are confirmed.
# MASSIVE_API_KEY=
# FLASHALPHA_API_KEY=
# FLOWALGO_API_KEY=

# Future app/backend services. Set these only on the server/runtime that needs them.
# DATABASE_URL=
# REDIS_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
