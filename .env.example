# The local server defaults to 10000. Render injects PORT automatically.
PORT=10000
NODE_ENV=development

# Preferred: full-universe historical bars plus current stock quotes.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Use iex on Alpaca's free feed. Use sip only when the account includes SIP data.
ALPACA_DATA_FEED=iex

# Historical-bar alternatives. Configure one provider path, not every path.
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MINUTE=8
POLYGON_API_KEY=
POLYGON_SYMBOLS_PER_MINUTE=5
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_SYMBOLS_PER_MINUTE=1

# Massive/Polygon quote snapshots require a plan with stock quote access.
MASSIVE_API_KEY=

# Optional licensed options-flow scanner and scheduled logger.
ANTHROPIC_API_KEY=
UW_API_TOKEN=
GOOGLE_SHEET_ID=
