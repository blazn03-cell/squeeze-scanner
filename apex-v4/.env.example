# Twelve Data API key — NEVER commit this file with a real key
TWELVEDATA_API_KEY=

# Tier: Grow ≈ 377 credits/min, Pro ≈ 1597 credits/min
# Set to 80% of your actual tier limit (safety margin is applied on top in code)
CREDITS_PER_MINUTE=8

# Comma-separated scan universe (leave blank to use built-in default 30-symbol list)
UNIVERSE=AAPL,MSFT,NVDA,AMD,TSLA,META,GOOGL,AMZN,NFLX,SPY,QQQ,SMCI,PLTR,MARA,COIN,RBLX,RIVN,LCID,GME,AMC,SOFI,HOOD,UPST,OPEN,BYND

# Set to false to disable decision log writing (logs/decisions.jsonl)
DECISION_LOG=false

# Local server port. Render injects PORT automatically.
PORT=3000
