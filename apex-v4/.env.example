# Twelve Data API key — NEVER commit this file with a real key
TWELVEDATA_API_KEY=

# Tier: Grow ≈ 377 credits/min, Pro ≈ 1597 credits/min
# Set to 80% of your actual tier limit (safety margin is applied on top in code)
CREDITS_PER_MINUTE=8

# Comma-separated scan universe (leave blank to use built-in default 30-symbol list)
UNIVERSE=AAPL,MSFT,NVDA,AMD,TSLA,META,GOOGL,AMZN,NFLX,SPY,QQQ,SMCI,PLTR,MARA,COIN,RBLX,RIVN,LCID,GME,AMC,SOFI,HOOD,UPST,OPEN,BYND

# Set to false to disable decision log writing (logs/decisions.jsonl)
DECISION_LOG=false

# Optional APEX QQQ event overlay. JSON only. Do not put secrets here.
# This lets Render supply event-specific levels/confirmations without hard-coding them.
# Example for an event watch:
# APEX_QQQ_EVENT_JSON={"catalyst":"FOMC","triggerPrice":720,"invalidationPrice":714,"nextLevels":[723,725,727],"triggerAccepted":false,"persistenceConfirmed":false,"priceStructure":"UNAVAILABLE","vwapOpeningRangeAcceptance":"UNAVAILABLE","weightedLeadership":"UNAVAILABLE","semiconductors":"UNAVAILABLE","breadth":"UNAVAILABLE","treasuryYields":"UNAVAILABLE","vixVxn":"UNAVAILABLE","nqFutures":"UNAVAILABLE","catalystVerification":"UNAVAILABLE","optionsFlow":"UNAVAILABLE","dealerGex":"UNAVAILABLE"}
APEX_QQQ_EVENT_JSON=

# Local server port. Render injects PORT automatically.
PORT=3000
